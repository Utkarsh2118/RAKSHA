# Copy this file to .env and replace placeholder values.
# Never commit real passwords, API keys, tokens, or secrets.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# PostgreSQL (Docker Compose service). Replace YOUR_PASSWORD with the local value from the repo-root .env.
DATABASE_URL="postgresql://raksha:YOUR_PASSWORD@localhost:5432/raksha?schema=public"
