generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  VOLUNTEER
  RESPONDER
  COORDINATOR
  ADMIN
}

enum EmergencyType {
  MEDICAL
  FIRE
  FLOOD
  EARTHQUAKE
  LANDSLIDE
  ACCIDENT
  CYCLONE
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EmergencyStatus {
  REPORTED
  VERIFIED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

model User {
  id                        String             @id @default(uuid()) @db.Uuid
  name                      String
  email                     String             @unique
  passwordHash              String
  role                      Role               @default(CITIZEN)
  isActive                  Boolean            @default(true)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  emergencyRequests         EmergencyRequest[] @relation("UserEmergencyRequests")
  assignedEmergencyRequests EmergencyRequest[] @relation("AssignedResponderEmergencyRequests")
}

model EmergencyRequest {
  id                  String          @id @default(uuid()) @db.Uuid
  reporterId          String          @db.Uuid
  assignedResponderId String?         @db.Uuid
  emergencyType       EmergencyType
  title               String
  description         String
  peopleAffected      Int
  severity            Severity
  latitude            Float
  longitude           Float
  locationText        String
  requiredHelp        String[]
  status              EmergencyStatus @default(REPORTED)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  reporter          User  @relation("UserEmergencyRequests", fields: [reporterId], references: [id])
  assignedResponder User? @relation("AssignedResponderEmergencyRequests", fields: [assignedResponderId], references: [id])

  @@index([reporterId])
  @@index([assignedResponderId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}
