generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  VOLUNTEER
  RESPONDER
  COORDINATOR
  ADMIN
}

enum EmergencyType {
  MEDICAL
  FIRE
  FLOOD
  EARTHQUAKE
  LANDSLIDE
  ACCIDENT
  CYCLONE
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EmergencyStatus {
  REPORTED
  VERIFIED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum ResourceType {
  FOOD
  WATER
  MEDICINE
  BLANKET
  TENT
  CLOTHING
  FIRST_AID
  VEHICLE
  RESCUE_EQUIPMENT
  POWER_SUPPLY
  OTHER
}

enum ResourceStatus {
  AVAILABLE
  LOW_STOCK
  OUT_OF_STOCK
  UNAVAILABLE
}

enum ResourceAllocationStatus {
  ALLOCATED
  RELEASED
  CANCELLED
}

model User {
  id                        String             @id @default(uuid()) @db.Uuid
  name                      String
  email                     String             @unique
  passwordHash              String
  role                      Role               @default(CITIZEN)
  isActive                  Boolean            @default(true)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  emergencyRequests         EmergencyRequest[] @relation("UserEmergencyRequests")
  assignedEmergencyRequests EmergencyRequest[] @relation("AssignedResponderEmergencyRequests")
  resources                 Resource[]         @relation("UserResources")
}

model EmergencyRequest {
  id                  String          @id @default(uuid()) @db.Uuid
  reporterId          String          @db.Uuid
  assignedResponderId String?         @db.Uuid
  emergencyType       EmergencyType
  title               String
  description         String
  peopleAffected      Int
  severity            Severity
  latitude            Float
  longitude           Float
  locationText        String
  requiredHelp        String[]
  status              EmergencyStatus @default(REPORTED)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  reporter            User                 @relation("UserEmergencyRequests", fields: [reporterId], references: [id])
  assignedResponder   User?                @relation("AssignedResponderEmergencyRequests", fields: [assignedResponderId], references: [id])
  resourceAllocations ResourceAllocation[]

  @@index([reporterId])
  @@index([assignedResponderId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

model Resource {
  id                String         @id @default(uuid()) @db.Uuid
  ownerId           String         @db.Uuid
  name              String
  type              ResourceType
  description       String?
  quantity          Int
  availableQuantity Int
  unit              String
  status            ResourceStatus @default(AVAILABLE)
  locationText      String?
  latitude          Float?
  longitude         Float?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  owner       User                 @relation("UserResources", fields: [ownerId], references: [id])
  allocations ResourceAllocation[]

  @@index([ownerId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model ResourceAllocation {
  id                 String                   @id @default(uuid()) @db.Uuid
  resourceId         String                   @db.Uuid
  emergencyRequestId String                   @db.Uuid
  quantity           Int
  status             ResourceAllocationStatus @default(ALLOCATED)
  allocatedAt        DateTime                 @default(now())
  releasedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  resource         Resource         @relation(fields: [resourceId], references: [id])
  emergencyRequest EmergencyRequest @relation(fields: [emergencyRequestId], references: [id])

  @@index([resourceId])
  @@index([emergencyRequestId])
  @@index([status])
  @@index([createdAt])
}
