# Copy this file to .env and replace placeholder values.
# Never commit real passwords, API keys, tokens, or secrets.

# PostgreSQL
POSTGRES_DB=raksha
POSTGRES_USER=raksha
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Future services (placeholders only — unused in this change set)
NODE_ENV=development
API_PORT=4000
AI_SERVICE_PORT=8000
CLIENT_PORT=5173
